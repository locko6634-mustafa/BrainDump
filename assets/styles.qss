/* ============================================================
   BrainDump — Premium Koyu Tema (Dark Theme)
   Renk Paleti: Monochrome (Koyu Kömür) + Neon Zümrüt Yeşili Pop
   ============================================================ */

/* ---- Genel Uygulama Stilleri ---- */
QMainWindow {
    background-color: #0e0e11;
    color: #f4f4f5;
}

QWidget {
    background-color: transparent;
    color: #f4f4f5;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
}

QWidget#central_widget {
    background-color: #0e0e11;
    border: 1px solid #27272a; /* 1px modern dış sınır çizgisi */
}

/* ---- Özel Başlık Çubuğu (Title Bar) ---- */
QWidget#custom_title_bar {
    background-color: #0c0c0f;
    border-bottom: 1px solid #1f1f23;
}

QLabel#title_bar_text {
    font-weight: 700;
    color: #f4f4f5;
}

QPushButton#title_btn_minimize,
QPushButton#title_btn_maximize,
QPushButton#title_btn_close {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

QPushButton#title_btn_minimize:hover,
QPushButton#title_btn_maximize:hover {
    background-color: rgba(244, 244, 245, 0.08);
}

QPushButton#title_btn_close:hover {
    background-color: #ef4444;
}

/* ---- Scroll Area ---- */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: #0e0e11;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #27272a;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #10B981;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background-color: #0e0e11;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #27272a;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #10B981;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    width: 0;
    background: none;
    border: none;
}

/* ---- Sidebar ---- */
QWidget#sidebar {
    background-color: #0c0c0f;
    border-right: 1px solid #1f1f23;
}

QPushButton#sidebar_toggle_btn {
    background-color: transparent;
    border: none;
    color: #a1a1aa;
    padding: 12px;
    text-align: left;
    font-size: 18px;
}

QPushButton#sidebar_toggle_btn:hover {
    color: #10B981;
    background-color: rgba(16, 185, 129, 0.08);
    border-radius: 8px;
}

/* Sidebar Logo/Brand */
QLabel#sidebar_brand {
    color: #10B981;
    font-size: 18px;
    font-weight: 700;
    padding: 0 8px;
    letter-spacing: 0.5px;
}

/* Sidebar Menü Öğeleri */
QPushButton#sidebar_btn {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #a1a1aa;
    text-align: left;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 500;
    margin: 2px 8px;
}

QPushButton#sidebar_btn:hover {
    background-color: rgba(16, 185, 129, 0.08);
    color: #f4f4f5;
}

QPushButton#sidebar_btn[active="true"] {
    background-color: rgba(16, 185, 129, 0.16);
    color: #10B981;
    font-weight: 600;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #0c0c0f;
    color: #a1a1aa;
    border-top: 1px solid #1f1f23;
    font-size: 12px;
    padding: 4px 12px;
}

QStatusBar QLabel {
    color: #a1a1aa;
    font-size: 12px;
}

/* ---- Sayfa Başlıkları ---- */
QLabel#page_title {
    font-size: 26px;
    font-weight: 700;
    color: #f4f4f5;
    padding-bottom: 4px;
    letter-spacing: -0.5px;
}

QLabel#page_subtitle {
    font-size: 14px;
    color: #a1a1aa;
    padding-bottom: 16px;
}

/* ---- Dashboard Sayfası ---- */
QLabel#welcome_title {
    font-size: 30px;
    font-weight: 800;
    color: #f4f4f5;
    padding: 0;
    letter-spacing: -0.5px;
}

QLabel#welcome_subtitle {
    font-size: 15px;
    color: #a1a1aa;
    padding-bottom: 24px;
}

QFrame#action_card {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
    padding: 24px;
}



QFrame#action_card QLabel#card_title {
    font-size: 16px;
    font-weight: 700;
    color: #f4f4f5;
    padding: 8px 0 4px 0;
}

QFrame#action_card QLabel#card_desc {
    font-size: 12px;
    color: #a1a1aa;
}

/* Son Aktiviteler Bölümü */
QFrame#activity_section {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
}

QWidget#activity_item {
    background-color: #27272a;
    border-radius: 8px;
    padding: 10px 16px;
}

QWidget#activity_item:hover {
    background-color: #323238;
}

QLabel#activity_text {
    color: #f4f4f5;
    font-weight: 500;
}

QLabel#activity_time {
    color: #a1a1aa;
    font-size: 12px;
}

/* ---- Formlar ve Giriş Elemanları ---- */
QLineEdit, QTextEdit, QComboBox {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 10px 12px;
    color: #f4f4f5;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #10B981;
    background-color: #1c1c21;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none; /* Standart ok yerine QSS ile veya qtawesome kullanılacak */
}

/* ---- Butonlar ---- */
QPushButton#primary_btn {
    background-color: #10B981;
    color: #09090b;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
}

QPushButton#primary_btn:hover {
    background-color: #34d399;
}

QPushButton#primary_btn:pressed {
    background-color: #059669;
}



QPushButton#secondary_btn {
    background-color: transparent;
    border: 1px solid #27272a;
    color: #f4f4f5;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
}

QPushButton#secondary_btn:hover {
    background-color: rgba(244, 244, 245, 0.08);
    border-color: #3f3f46;
}

QPushButton#secondary_btn:pressed {
    background-color: rgba(244, 244, 245, 0.12);
}



QPushButton#danger_btn {
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#danger_btn:hover {
    background-color: #ef4444;
    color: #ffffff;
}

QPushButton#danger_btn:pressed {
    background-color: #b91c1c;
}



/* ---- Kart Listeleri (Notlar ve Hedefler için) ---- */
QFrame#item_card {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
}



QLabel#item_title {
    font-size: 16px;
    font-weight: 700;
    color: #f4f4f5;
}

QLabel#item_desc {
    color: #a1a1aa;
    font-size: 13px;
}

QLabel#item_meta {
    color: #71717a;
    font-size: 11px;
}

QLabel#item_badge {
    background-color: rgba(16, 185, 129, 0.12);
    color: #10B981;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* ---- Hedef (Goal) Checkbox & List ---- */
QCheckBox {
    spacing: 12px;
    color: #f4f4f5;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 1px solid #27272a;
    border-radius: 6px;
    background-color: #18181b;
}

QCheckBox::indicator:hover {
    border-color: #10B981;
}

QCheckBox::indicator:checked {
    background-color: #10B981;
    border-color: #10B981;
    image: url(assets/check.png); /* Fallback ok veya QSS ile renklendirme */
}

/* ---- Ayarlar ve İstatistikler ---- */
QLabel#setting_label {
    font-weight: 600;
    color: #f4f4f5;
}

QFrame#stat_card {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
}

QLabel#stat_val {
    font-size: 32px;
    font-weight: 800;
    color: #10B981;
}

QLabel#stat_lbl {
    font-size: 12px;
    color: #a1a1aa;
}

/* ---- Dialoglar ---- */
QDialog {
    background-color: #0e0e11;
    border: 1px solid #27272a;
}

/* ---- Eklenen Widget ve Stil Kuralları (Faz 1) ---- */

/* Hızlı eylem kartı */
QFrame#hover_card QLabel#card_title {
    font-size: 15px;
    font-weight: 600;
    color: #e8e8e8;
    background: transparent;
}

QFrame#hover_card QLabel#card_description {
    font-size: 12px;
    color: #a0a0b8;
    background: transparent;
}

/* Dashboard son aktiviteler */
QLabel#section_title {
    font-size: 16px;
    font-weight: 600;
    color: #e8e8e8;
}

QLabel#activity_row {
    font-size: 13px;
    color: #a0a0b8;
    padding: 6px 0px;
    border-bottom: 1px solid #2a2a4a;
}

QLabel#activity_row_empty {
    font-size: 13px;
    color: #6a6a8a;
    padding: 6px 0px;
    font-style: italic;
}

/* Yeni Not / Form Etiketleri */
QLabel#form_label {
    font-size: 13px;
    font-weight: 600;
    color: #a0a0b8;
}

QFrame#form_frame {
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
}

QPushButton#cancel_btn {
    background: transparent;
    border: 1px solid #27272a;
    border-radius: 8px;
    color: #a1a1aa;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
}

QPushButton#cancel_btn:hover {
    border-color: #ef4444;
    color: #ef4444;
}

QPushButton#save_btn {
    background: #10B981;
    border: none;
    border-radius: 8px;
    color: #09090b;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
}

QPushButton#save_btn:hover {
    background: #34d399;
}

QPushButton#save_btn:disabled {
    background: #27272a;
    color: #71717a;
}

QLabel#hint_label {
    font-size: 12px;
    color: #a0a0b8;
    font-style: italic;
    margin-top: 8px;
}

/* Not Kartı */
QLabel#note_card_title {
    font-size: 15px;
    font-weight: 700;
    color: #e8e8e8;
    background: transparent;
}

QLabel#note_card_preview {
    font-size: 12px;
    color: #a0a0b8;
    background: transparent;
}

QLabel#note_card_date {
    font-size: 11px;
    color: #6a6a8a;
    background: transparent;
}

QLabel#category_tag {
    font-size: 10px;
    color: #10B981;
    background: rgba(16, 185, 129, 0.12);
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
}

QPushButton#delete_btn {
    background: transparent;
    border: none;
    border-radius: 4px;
}

QPushButton#delete_btn:hover {
    background: rgba(255, 82, 82, 0.15);
}

/* Hedef Sayfası ve Ögeleri */
QFrame#goal_item {
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 10px;
}

QLabel#goal_text {
    font-size: 14px;
    color: #e8e8e8;
}

QLabel#goal_text[completed="true"] {
    color: #6a6a8a;
}

QLabel#lbl_progress {
    font-size: 11px;
    color: #a0a0b8;
}

QLabel#lbl_progress[completed="true"] {
    color: #52526b;
}

/* İlerleme Çubuğu (ProgressBar) */
QProgressBar {
    border: 1px solid #27272a;
    background-color: #18181b;
    border-radius: 8px;
    text-align: center;
    color: #f4f4f5;
    font-weight: bold;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #10B981;
    border-radius: 7px;
}

/* İstatistik Kartı ve Değerler */
QLabel#stat_value {
    font-size: 26px;
    font-weight: 800;
    color: #e8e8e8;
}

QLabel#stat_label {
    font-size: 12px;
    color: #a0a0b8;
    font-weight: 500;
}

QFrame#activity_summary {
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
}

/* Ayarlar */
QFrame#settings_group {
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
}

QLabel#group_title {
    font-size: 16px;
    font-weight: 700;
    color: #f4f4f5;
    padding-bottom: 4px;
    border-bottom: 1px solid #27272a;
}

QLabel#setting_label_text {
    font-size: 14px;
    color: #a0a0b8;
}

QLabel#setting_value_text {
    font-size: 14px;
    color: #e8e8e8;
}

/* Diyaloglar */
QFrame#dialog_container {
    background: #0e0e11;
    border: 1px solid #27272a;
    border-radius: 12px;
}

QLabel#dialog_title {
    color: #f4f4f5;
    font-weight: 700;
    font-size: 14px;
}

QLabel#dialog_info_label {
    color: #a0a0b8;
    font-size: 13px;
}

/* Toast Bildirimleri */
QFrame#toast_widget {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 8px;
}

QLabel#toast_title {
    font-weight: bold;
    font-size: 13px;
    color: #f4f4f5;
}

QLabel#toast_message {
    font-size: 12px;
    color: #a1a1aa;
}


